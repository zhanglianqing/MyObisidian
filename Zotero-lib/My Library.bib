@article{yangChangesBrainStructure2020,
  title = {Changes of {{Brain Structure}} in {{Patients With Metastatic Non-Small Cell Lung Cancer After Long-Term Target Therapy With EGFR-TKI}}},
  author = {Yang, Beisheng and Luo, Chunli and Yu, Min and Zhou, Lin and Tao, Bo and Tang, Biqiu and Zhou, Ying and Zhu, Jiang and Huang, Meijuan and Peng, Feng and Liu, Yongmei and Xu, Yong and Zhang, Yan and Zhou, Xiaojuan and Xue, Jianxin and Li, Yanying and Wang, Yongsheng and Li, Zhiping and Lu, You and Lui, Su and Gong, Youling},
