  keywords = {Brain,Brain Mapping,decoded neurofeedback (DecNef),external reward,fMRI neurofeedback,functional connectivity-based neurofeedback (FCNef),Humans,implicit neurofeedback,Magnetic Resonance Imaging,multivariate analysis,Neurofeedback},
