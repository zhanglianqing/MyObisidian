@article{chenRelationshipCognitiveDisorder2025,
  title = {Relationship {{Between Cognitive Disorder}} and {{First-Line Targeted Therapy}} for {{Oncogene Driver}}--{{Positive Patients With Non}}--{{Small Cell Lung Cancer}}: {{Prospective Cohort Study}}},
  shorttitle = {Relationship {{Between Cognitive Disorder}} and {{First-Line Targeted Therapy}} for {{Oncogene Driver}}--{{Positive Patients With Non}}--{{Small Cell Lung Cancer}}},
  author = {Chen, Wenjun and Hu, Xueyang and Yao, Senbang and Bi, Ziran and Chen, Maoxi and Cheng, Huaidong},
  year = 2025,
  month = sep,
  journal = {JMIR Cancer},
  volume = {11},
  number = {1},
  pages = {e59647},
  publisher = {JMIR Publications Inc., Toronto, Canada},
  doi = {10.2196/59647},
  urldate = {2026-05-05},
  abstract = {Background: Previous studies have found and confirmed a correlation between cognitive disorder and chemotherapy. As genetic testing becomes more routine in clinical practice, targeted therapies are increasingly gaining prominence. The relationship between targeted treatment and cognitive function is not yet clear. This study aimed to investigate the correlation between cognitive disorder and targeted treatment by evaluating the changes in cognitive function before and after targeted therapy. Objective: This study aims to explore whether targeted therapy affects cognitive function in patients with advanced lung cancer and to explore the association between cognitive function, the inflammatory biomarker C-reactive protein, and psychological stress. Methods: From the screened cohort of 150 patients with advanced non--small cell lung cancer (NSCLC) with gene mutations, 87 (58\%) were rigorously selected for the study. The evaluation instruments used were the Mini-Mental State Examination scale, the Distress Thermometer, and the European Organisation for Research and Treatment of Cancer Quality of Life Questionnaire Core 30 for assessing quality of life. Results: A significantly lower progression-free survival (PFS) was observed in the group of patients surviving advanced NSCLC with cognitive disorder under targeted therapy in contrast to survivors in the group with no cognitive disorder (hazard ratio=0.347, 95\% CI 0.209-0.578; P\&lt;.001). Furthermore, the objective response rate and disease control rate for the group with cognitive disorder were noted to be 37.8\% and 86.7\%, respectively, contrastingly lower than those in the group with no cognitive disorder, recorded at 78.6\% and 97.6\%, respectively. Significant variances were also noted in the Mini-Mental State Examination scores between patients with and without cognitive disorder both before and after targeted therapy (P\&lt;.001 in both cases), with a decreasing trend observed in both groups after targeted therapy. Noteworthy differences were found in quality of life scores both before and after targeted therapy (P\&lt;.001 in both cases). In addition, notable disparities were apparent in C-reactive protein levels among the 2 groups before and after treatment (P=.03 and P=.048 for each time point, respectively), with an upward trend observed in both groups after targeted therapy. The multivariate Cox regression analysis demonstrated that cognitive function is an independent risk factor for PFS in patients with NSCLC receiving targeted therapy. Conclusions: Cognitive disorder may lead to lower quality of life scores and shorter PFS in patients undergoing targeted therapy. Early screening and intervention for such patients could effectively improve clinical outcomes and quality of life.},
  copyright = {Unless stated otherwise, all articles are open-access distributed under the terms of the Creative Commons Attribution License (http://creativecommons.org/licenses/by/2.0/), which permits unrestricted use, distribution, and reproduction in any medium, provided the original work ("first published in the Journal of Medical Internet Research...") is properly cited with original URL and bibliographic citation information. The complete bibliographic information, a link to the original publication on http://www.jmir.org/, as well as this copyright and license information must be included.},
  langid = {english},
  note = {Chen 等 (2025) \textbf{1} 的研究题目是《认知障碍与非小细胞肺癌癌基因驱动阳性患者一线靶向治疗的关系：前瞻性队列研究》。\\
这篇论文旨在探讨靶向治疗对晚期非小细胞肺癌（NSCLC）患者认知功能的影响，并评估认知功能与炎症生物标志物C反应蛋白（CRP）和心理困扰之间的关联。\\
\textbf{研究背景}\\
肺癌是全球主要的死亡原因，其中非小细胞肺癌占85\% \textbf{1}。传统的铂类化疗虽然是晚期NSCLC的一线治疗，但中位总生存期和无进展生存期（PFS）有限 [3]。随着基因检测的普及，靶向治疗显著改善了携带敏感基因突变（如EGFR和ALK）的NSCLC患者的预后、PFS和生活质量（QoL） [5-7][5-7][5-7]。过去的研究已经证实化疗和放疗与癌症患者的认知功能下降有关 [20-22][20-22][20-22]，但靶向治疗与认知功能之间的关系尚不明确。\\
\textbf{研究目的}\\
本研究旨在通过评估靶向治疗前后认知功能的变化，探究靶向治疗是否影响晚期肺癌患者的认知功能。同时，研究还希望探讨认知功能与炎症生物标志物C反应蛋白（CRP）以及心理困扰之间的关联。\\
\textbf{研究方法}
\par
\begin{itemize}

\item \textbf{设计}：一项前瞻性队列研究，招募期为2020年5月至2023年12月。
\item \textbf{参与者}：从150名晚期NSCLC伴基因突变（EGFR或ALK）的患者中筛选出87名符合条件的患者。纳入标准包括：初次确诊肺腺癌并有基因突变、未接受过任何抗肿瘤治疗且符合一线靶向治疗条件、预期生存期大于6个月、无精神或神经系统疾病史、Karnofsky体能状态评分{$\geq$}80。
\item 
\par
\textbf{评估工具}：
\par
\begin{itemize}

\item 认知功能：简易精神状态检查量表（MMSE），以26分或以下作为认知障碍的界限 [36-38]。
\item 心理困扰：困扰温度计（DT） [29]。
\item 生活质量：欧洲癌症研究与治疗组织生活质量问卷核心30（EORTC QLQ-C30） [29]。

\end{itemize}

\item \textbf{数据收集}：在基线（首次靶向治疗前）和治疗8周或肿瘤进展时再次收集MMSE、DT和EORTC QLQ-C30评分。同时检测CRP水平。
\item \textbf{基因检测}：采用高通量测序（二代测序）检测139个肺癌相关基因。
\item \textbf{统计分析}：使用SPSS 24进行统计分析，包括t检验、卡方分析、非参数检验、线性回归和Cox回归分析，P{$<$}.05为统计学显著性水平。\\
\textbf{研究结果}
\item \textbf{患者分组}：87名患者中，42名（48\%）无认知障碍，45名（52\%）有认知障碍。两组间在年龄、性别、教育水平、肿瘤分期、远处转移情况和靶向治疗药物类型等基线特征上无显著差异。
\item \textbf{治疗效果}：认知障碍组的客观缓解率（ORR）为37.8\%，疾病控制率（DCR）为86.7\%，显著低于无认知障碍组（ORR 78.6\%，DCR 97.6\%），差异具有统计学意义（P{$<$}.001）。
\item \textbf{认知功能与靶向治疗}：靶向治疗前后，两组的MMSE评分均有显著差异（P{$<$}.001）。靶向治疗后，两组MMSE评分均下降，其中认知障碍组下降幅度更大（P{$<$}.001）。靶向治疗后，MMSE评分与心理困扰评分呈负相关（R2=0.426; P{$<$}.001）。
\item \textbf{生活质量与认知障碍}：靶向治疗前后，认知障碍组的生活质量评分均显著低于无认知障碍组（P{$<$}.001）。靶向治疗后，MMSE评分与生活质量评分呈正相关（R2=0.235; P{$<$}.001）。
\item \textbf{CRP浓度与认知障碍}：靶向治疗前后，认知障碍组的CRP浓度均显著高于无认知障碍组（P=.03和P=.048）。两组在靶向治疗后CRP水平均呈上升趋势。心理困扰评分与靶向治疗后的CRP浓度呈正相关（R2=0.058; P=.03）。
\item \textbf{无进展生存期（PFS）}：认知障碍组的PFS显著短于无认知障碍组（中位PFS分别为9个月 vs 14个月），差异具有统计学意义（P{$<$}.001）。
\item \textbf{PFS影响因素}：多变量Cox回归分析显示，认知功能是影响NSCLC患者接受靶向治疗后PFS的独立风险因素（P=.03），认知功能越差，PFS越短。\\
\textbf{讨论}\\
本研究的主要发现是，认知障碍与晚期NSCLC患者接受靶向治疗后的生活质量和临床结局（如ORR、DCR、PFS）密切相关 \textbf{1}。认知障碍患者的生活质量评分更低，PFS更短，治疗效果也更差。研究发现，靶向治疗可能加重认知功能障碍的程度。此外，C反应蛋白作为炎症标志物，其水平与认知功能和心理困扰均有显著关联，CRP水平升高可能是认知障碍的风险预测因子 [54,55][54,55]。心理困扰也与认知功能下降和炎症介质水平升高密切相关 [59,63-65][59,63-65][59,63-65][59,63-65]。这些结果支持了癌症相关认知障碍是一个复杂的生物心理社会问题。\\
\textbf{研究局限性}\\
本研究存在样本量较小的问题，这可能影响统计效力并增加假阴性结果的可能性。样本量受限于经济因素（基因检测费用高）、基因检测结果延迟导致患者选择化疗、社会经济因素和患者偏好引入的选择偏差，以及患者参与其他临床试验等因素 \textbf{1}。\\
\textbf{未来方向}\\
未来的研究应更深入地探讨靶向抗癌疗法与治疗相关认知功能障碍之间的精确分子机制，包括血脑屏障破坏、神经炎症或直接神经元毒性等病理生理途径。此外，化疗联合靶向治疗是否会加重认知障碍也需进一步探索。\\
\textbf{结论}\\
本研究证实，靶向治疗后，先前存在认知障碍的患者生活质量显著降低，PFS更差。心理因素、认知障碍和CRP浓度在晚期肺癌患者中存在显著关联。因此，对这类患者进行早期筛查、咨询和有效干预至关重要，这有助于改善临床疗效和生活质量 [1]。

\end{itemize}},
  file = {L:\zotero\literature\NeuroImaging study following cancer\Chen et al._2025_Relationship Between Cognitive Disorder and First-.pdf}
}

