@article{silvermanNeuroimagingStudiesCognitive2025,
  title = {Neuroimaging Studies of Cognitive Dysfunction Following Cancer and Treatment},
  author = {Silverman, Daniel H. S. and Sleurs, Charlotte and Gavrila Laic, Rebeca A. and Amidi, Ali and Chen, Bihong T. and Deprez, Sabine and McDonald, Brenna C.},
  year = 2025,
  month = sep,
  journal = {Journal of Clinical and Experimental Neuropsychology},
  volume = {47},
  number = {8},
  pages = {847--873},
  publisher = {Routledge},
  issn = {1380-3395},
  doi = {10.1080/13803395.2025.2526647},
  urldate = {2026-05-05},
  abstract = {Survival rates for non-central nervous system cancers (CNS) have markedly improved in recent decades due to advancements in early detection and treatment; however, this progress has also led to a rise in survivors living with long-term side effects, including cancer-related cognitive impairment (CRCI). Neuroimaging has been vital in understanding the impact of cancer and its treatments on brain functioning, revealing changes in brain activity, structure, and connectivity associated with cognitive decline. This review summarizes current neuroimaging research on adults with non-CNS cancers, focusing on alterations in gray and white matter and functional, metabolic, and vascular changes. Consistent findings of alterations in the prefrontal cortex have been observed, with both structural and functional changes observed in patients with CRCI, and limbic and temporal structures also appear to be impacted. These brain changes have been shown to correlate with functioning on objective and self-reported measures of executive functioning and memory. Future research should further explore novel complementary techniques and analytic approaches, to provide more in-depth knowledge on various potential mechanisms contributing to CRCI. Multimodal investigations of biomarkers including genomic interactions, neuroinflammatory processes, oxidative stress, blood-brain barrier disruption, and gut-brain axis effects could yield new insights. Neuroimaging will remain essential in elucidating these mechanisms and their roles in CRCI.},
  pmid = {40598923},
  keywords = {Cancer-Related Cognitive Impairment,cognition,neuroimaging,neuropsychology,review},
  file = {L:\zotero\literature\Silverman 等_2025_Neuroimaging studies of cognitive dysfunction foll.pdf}
}

@article{simoBrainFunctionalConnectivity2018,
  title = {Brain Functional Connectivity in Lung Cancer Population: An Exploratory Study},
  shorttitle = {Brain Functional Connectivity in Lung Cancer Population},
  author = {Sim{\'o}, M. and {Rif{\`a}-Ros}, X. and Vaquero, L. and Ripoll{\'e}s, P. and Cayuela, N. and Jov{\'e}, J. and Navarro, A. and Cardenal, F. and Bruna, J. and {Rodr{\'i}guez-Fornells}, Antoni},
  year = 2018,
  month = apr,
  journal = {Brain Imaging and Behavior},
  volume = {12},
  number = {2},
  pages = {369--382},
  issn = {1931-7565},
  doi = {10.1007/s11682-017-9697-8},
  urldate = {2026-05-14},
  abstract = {The present study aimed to explore the functional connectivity differences in Resting State Networks (RSNs) induced by cancer and chemotherapy in Lung Cancer (LC) patients using an Independent Component Analysis (ICA). Three matched groups of 15 LC patients following Chemotherapy (C+), 15 LC patients before Chemotherapy (C-) and 15 Healthy Controls (HC) were included. Analysis was performed using ICA and a multivariate pattern analysis (MVPA) to classify groups based on profiles of functional connectivity. We found significant differences in four of the RSN identified: Default Mode Network (DMN), Predominantly Left and Right Anterior Temporal Network, and Cerebellum Network. Whereas DMN showed decreased connectivity, the other RSNs exhibited increased connectivity in both LC groups compared to HC and in C+ in comparison to C-. MVPA discriminated significantly and accurately between all groups. Our study showed that disrupted functional connectivity associated with cancer and chemotherapy-induced cognitive deficits is not only related to DMN decreased connectivity abnormalities but also to an increased connectivity of other RSNs, suggesting a potential compensatory mechanism.},
  langid = {english},
  keywords = {Chemotherapy,Default mode network,Functional connectivity,Lung cancer,Resting-state functional magnetic resonance imaging},
  file = {L:\zotero\literature\NeuroImaging study following cancer\Simó et al._2018_Brain functional connectivity in lung cancer popul.pdf}
}

@article{simoCancerRelatedCognitiveImpairment2025,
  title = {Cancer-{{Related Cognitive Impairment}} in {{Patients With Lung Cancer}}},
  author = {Sim{\'o}, Marta and Vaquero, Luc{\'i}a and Alemany, Montserrat and Padrones, Susana and Oliv{\'e}, Guillem and Caravaca, Alejandro and {Padr{\'o}-Miquel}, Ariadna and Nadal, Ernest and Camara, Estela and Graus, Francesc and Bruna, Jordi},
  year = 2025,
  month = jun,
  journal = {Neurology},
  volume = {104},
  number = {12},
  pages = {e213651},
  issn = {0028-3878, 1526-632X},
  doi = {10.1212/WNL.0000000000213651},
  urldate = {2026-05-12},
  abstract = {Objectives The aim of this study was to identify biomarkers of cancer-related cognitive impairment (CRCI) in patients with small-cell lung cancer (SCLC).},
  langid = {english},
  note = {这是一篇关于小细胞肺癌 (SCLC) 患者癌症相关认知障碍 (CRCI) 的研究论文，由 Sim\'o 等人于 2025 年发表 [1]。 以下是对全文内容的详细分段概括：
\par
\subsubsection{1. 论文概述 (Overall Summary)}

\par
Sim\'o 等人 (2025) [1] 的这项研究旨在识别小细胞肺癌 (SCLC) 患者癌症相关认知障碍 (CRCI) 的生物标志物，并探讨其临床特征、生物标志物和脑部变化。研究发现约三分之一的 SCLC 患者在诊断时即存在认知障碍 (CI)，而化疗引起的``化疗脑''不常见，且主要与吸烟暴露和BDNF基因变异有关。研究强调了早期生物标志物在预测 CRCI 及其持续性方面的作用。
\par
\subsubsection{2. 研究目的 (Objectives)}

\par
本研究的主要目的是识别小细胞肺癌 (SCLC) 患者癌症相关认知障碍 (CRCI) 的生物标志物 [1]。研究还旨在探讨与 SCLC 患者基线 CRCI 相关的临床特征、生物标志物和脑部变化 [1]。
\par
\subsubsection{3. 研究方法 (Methods)}

\par
研究在 2019 年至 2023 年间前瞻性招募了 SCLC 患者 [1]。对患者进行了多方面评估，包括：
\par
\begin{itemize}

\item \textbf{神经心理学 (NPS) 量表}：评估认知功能。
\item \textbf{结构性 MRI}：采用基于体素形态学 (VBM) 和基于束的分析来评估灰质和白质的完整性 [1]。
\item \textbf{血清学分析}：检测神经元抗体、细胞因子、脑源性神经营养因子 (BDNF) [1]。
\item \textbf{认知相关单核苷酸变异 (SNVs) 分析} [1]。 患者在完成化疗后一个月进行再评估 [1]。研究排除了在 V1 评估时有全身或脑部疾病进展的患者 [1]。

\end{itemize}

\subsubsection{4. 研究结果 (Results)}

\subsubsubsection{4.1 基线评估结果 (Pretreatment Baseline Characteristics)}

\begin{itemize}

\item \textbf{认知障碍发生率}：最初评估的 52 名患者中，16 名 (31\%) 在基线时表现出认知障碍 (CI) [1]。
\item \textbf{主要受影响的认知领域}：主要影响执行功能，包括言语流畅性和处理速度 [1]。在视空间能力和视觉记忆方面也表现较差 [1]。
\item \textbf{MRI 发现}：MRI 显示右侧楔前叶和梭形-海马旁区域的灰质受损，这些区域与视空间能力和记忆相关 [1]。此外，扣带回和胼胝体也存在白质损伤，表现为放射状弥散度增加和分数各向异性降低，表明白质完整性受损和脱髓鞘 [1]。
\item \textbf{生物标志物及临床特征}：基线 CI 组和非 CI 组在年龄、性别、教育程度、吸烟、饮酒、血管危险因素、脑转移、副肿瘤综合征、肿瘤神经元抗体、细胞因子水平或常见 SNVs（如 MDR1, OGG1, PARP1, COMT, ApoE E4）方面没有显著差异 [1]。仅血清 BDNF 在基线 CI 组中呈下降趋势 (171 \textpm{} 39 vs 205 \textpm{} 57 pg/mL, p = 0.07) [1]。

\end{itemize}

\subsubsubsection{4.2 化疗后评估结果 (Postchemotherapy Assessment (V1))}

\begin{itemize}

\item \textbf{再评估患者}：化疗后有 31 名患者接受了再评估 (V1) [1]。
\item \textbf{CI 发生率及分类}：其中 10 名患者 (32\%) 表现出 CI：7 名 (23\%) 存在持续性 CI，3 名 (10\%) 出现新发 CI（即``化疗脑''） [1]。
\item \textbf{认知表现}：V1 CI 组在执行功能方面低于正常标准，且在视空间能力、视觉记忆和 TMT-A 方面比 V1 非 CI 患者表现更差 [1]。
\item \textbf{疾病进展关联}：V1 CI 患者在诊断时疾病进展更晚期（70\% vs 24\%, p = 0.02） [1]。SNVs、神经元抗体、细胞因子或基线 BDNF 水平无显著差异 [1]。

\end{itemize}

\subsubsubsection{4.3 认知表现从基线到化疗后的变化 (Changes in Cognitive Performance From Baseline to V1)}

\begin{itemize}

\item \textbf{``从未出现 CI''组}：基线非 CI 组中的 18 名患者有 15 名 (83\%) 保持稳定，被标记为``从未出现 CI'' [1]。
\item \textbf{``化疗脑''组}：3 名患者在 V1 出现 CI，构成``化疗脑''组。该组吸烟暴露更高（60 vs 44 包年，p = 0.05） [1]，并且所有患者都携带 BDNF 基因的风险变异 C{$>$}T [1]。
\item \textbf{``持续性 CI''组}：基线 CI 患者（n=13）中，7 名患者表现为持续性 CI。该组在诊断时疾病更晚期（80\% vs 20\%，p = 0.004） [1]，基线时执行功能最差，且缺陷持续存在，化疗后还出现了额外的视空间能力缺陷 [1]。
\item \textbf{认知改善组}：6 名基线 CI 患者在化疗后言语工作记忆有所改善 [1]。

\end{itemize}

\subsubsection{5. 讨论 (Discussion)}

\begin{itemize}

\item \textbf{CRCI 的普遍性}：研究结果表明，在 SCLC 患者中，约三分之一在诊断时即存在 CRCI [1]。化疗脑并不常见 (10\%)，且主要与烟草使用和 BDNF 风险多态性相关 [1]。
\item \textbf{CRCI 的影响因素}：基线 CI 的认知特征（执行功能、视空间能力和记忆缺陷）与化疗后报告的 CRCI 相似 [1]，提示 SCLC 中的 CRCI 主要受预先存在的认知障碍影响 [1]。
\item \textbf{脑结构变化}：与 CRCI 相关的结构性脑损伤（包括灰质和白质损伤）在 SCLC 患者诊断时就已存在 [1]。
\item \textbf{预测因素}：基线 CRCI 的严重程度，特别是执行功能方面的缺陷，是预测长期认知恶化的关键因素 [1]。
\item \textbf{可逆机制}：化疗后认知功能改善的患者通常处于有限期疾病阶段，并具有独特的认知特征，暗示存在潜在的可逆机制 [1]。
\item \textbf{研究局限性与意义}：尽管研究存在样本量小和随访时间短的局限性 [1]，但它是描述 SCLC 患者 CRCI 临床特征、血清学和脑部变化方面最大规模的研究之一 [1]。这为评估新型疗法的潜在认知影响提供了历史基准，并强调了运动等非药物方法在解决认知衰退中的作用 [1]。

\end{itemize}},
  file = {L:\zotero\literature\NeuroImaging study following cancer\Simó 等_2025_Cancer-Related Cognitive Impairment in Patients Wi.pdf}
}

@article{tangDivergentEffectsSex2024,
  title = {Divergent Effects of Sex on Hippocampal Subfield Alterations in Drug-Naive Patients with Major Depressive Disorder},
  author = {Tang, Mengyue and Zhang, Lianqing and Zhou, Zilin and Cao, Lingxiao and Gao, Yingxue and Wang, Yingying and Li, Hailong and Hu, Xinyue and Bao, Weijie and Liang, Kaili and Kuang, Weihong and Sweeney, John A. and Gong, Qiyong and Huang, Xiaoqi},
  year = 2024,
  month = jun,
  journal = {Journal of Affective Disorders},
  volume = {354},
  pages = {173--180},
  issn = {01650327},
  doi = {10.1016/j.jad.2024.03.082},
  urldate = {2026-05-06},
  abstract = {Background: The hippocampus is a crucial brain structure in etiological models of major depressive disorder (MDD). It remains unclear whether sex differences in the incidence and symptoms of MDD are related to differential illness-associated brain alterations, including alterations in the hippocampus. This study investigated divergent the effects of sex on hippocampal subfield alterations in drug-naive patients with MDD. Methods: High-resolution structural MR images were obtained from 144 drug-naive individuals with MDD early in their illness course and 135 age- and sex-matched healthy controls (HCs). Hippocampal subfields were segmented using FreeSurfer software and analyzed in terms of both histological subfields (CA1--4, dentate gyrus, etc.) and more integrative larger functional subregions (head, body and tail). Results: We observed a significant overall reduction in hippocampal volume in MDD patients, with deficits more prominent deficits in the posterior hippocampus. Differences in anatomic alterations between male and female patients were observed in the CA1-head, presubiculum-body and fimbria in the left hemisphere. Exploratory analyses revealed different patterns of clinical and memory function correlations with histological subfields and functional subregions between male and female patients primarily in the hippocampal head and body. Limitations: This cross-sectional study cannot clarify the causality of hippocampal alterations or their association with illness risk or onset. Conclusions: These findings represent the first reported sex-specific alterations in hippocampal histological subfields in patients with MDD early in the illness course prior to treatment. Sex-specific hippocampal alterations may contribute to diverse sex differences in the clinical presentation of MDD.},
  langid = {english},
  file = {L:\zotero\literature\Untitled\Tang et al._2024_Divergent effects of sex on hippocampal subfield a.pdf}
}

@article{voynovMultimodalCancerTherapy2026,
  title = {Multimodal {{Cancer Therapy}} and {{Accelerated Brain Aging}}: {{Mechanisms}}, {{Biomarkers}}, and {{Clinical Consequences}}},
  shorttitle = {Multimodal {{Cancer Therapy}} and {{Accelerated Brain Aging}}},
  author = {Voynov, Mark and Pospelova, Maria and Nikolaeva, Alexandra and Krasnikova, Varvara and Makhanova, Albina and Fionik, Olga and Samochernykh, Konstantin and Alekseeva, Tatyana and Combs, Stephanie E. and Shevtsov, Maxim},
  year = 2026,
  month = feb,
  journal = {Current Oncology},
  volume = {33},
  number = {2},
  pages = {121},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {1718-7729},
  doi = {10.3390/curroncol33020121},
  urldate = {2026-05-05},
  abstract = {Advances in cancer therapy have markedly improved survival rates; however, long-term neurological sequelae represent a significant clinical challenge. Cancer treatment-related cognitive impairment (CRCI), commonly referred to as ``chemobrain'', affects a substantial proportion of cancer survivors and encompasses a broad spectrum of neuropsychiatric and cognitive symptoms, including anxiety, depression, fatigue, balance disturbances, and deficits in attention, memory, processing speed, and executive function. Increasing evidence suggests that these manifestations reflect accelerated biological aging of the brain, rather than merely transient toxic effects. This review synthesizes current clinical, molecular, and neuroimaging evidence supporting the concept of accelerated brain aging associated with multimodal cancer therapy. We summarize key molecular and cellular mechanisms including oxidative stress, neuroinflammation, blood--brain barrier dysfunction, mitochondrial impairment, cellular senescence with a senescence-associated secretory phenotype, and epigenetic remodeling that overlap with physiological brain aging hallmarks. Particular attention is given to circulating molecular biomarkers of accelerated aging, such as inflammatory mediators, senescence markers, endothelial and neuronal injury indicators, and epigenetic age acceleration, and their potential translational relevance. We discuss clinical and neuropsychological data alongside structural and functional magnetic resonance imaging findings demonstrating cortical thinning, altered gyrification, white matter microstructural changes, disrupted functional connectivity, and increased brain age estimates following cancer therapy. Framing CRCI within an accelerated brain aging paradigm may improve risk stratification, guide biomarker development, and inform personalized survivorship care.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  keywords = {accelerated brain aging,cancer survivorship,cancer-related cognitive impairment,chemotherapy,cognitive dysfunction,radiotherapy,targeted therapy},
  file = {L:\zotero\literature\NeuroImaging study following cancer\Voynov et al._2026_Multimodal Cancer Therapy and Accelerated Brain Ag.pdf}
}

